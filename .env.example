APP_NAME=ComptaFlow
APP_ENV=local
APP_KEY=
APP_DEBUG=true

# L'adresse publique de l'application.
#
# Elle n'est pas décorative : `route()` la lit pour construire les liens
# envoyés par courriel — dont le lien d'activation par lequel un client
# choisit son mot de passe. Une valeur fausse et le lien part vers une
# adresse qui n'existe pas.
#
# En **https** : le client saisit son mot de passe sur la page au bout du
# lien, et un avertissement de certificat sur cette page-là est le pire
# endroit possible pour en avoir un.
APP_URL=https://comptaflow.dc-knowing.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=
# DB_USERNAME=
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="ne-pas-repondre@comptaflow.dc-knowing.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── Passerelle Selflow ↔ ComptaFlow ────────────────────────────────────────
#
# Le secret serveur n'a **aucune valeur de repli dans le code** : sans lui, les
# points d'entrée externes refusent tout. C'est voulu — ils créent des dossiers
# et rendent des clés de liaison — mais cela veut dire qu'une installation qui
# oublie cette ligne verra la synchronisation refuser en bloc, sans autre
# explication qu'un 401.
#
# Il doit être identique dans les deux `.env`, et il ne dit **pas** quelle
# entreprise appelle : c'est le rôle de la clé `X-Company-Key`, propre à chaque
# dossier, que ComptaFlow génère.
EXTERNAL_SYNC_SECRET=
SELFLOW_API_URL=
EXTERNAL_API_TIMEOUT=15

# ─── Scan de factures ───────────────────────────────────────────────────────
#
# Aucune clé n'est écrite ici. Une clé d'API versionnée est une clé publiée :
# la retirer d'un fichier ne la retire pas de l'historique du dépôt, il faut la
# révoquer chez le fournisseur.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
